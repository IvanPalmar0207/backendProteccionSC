# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API (Angular dev server)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Database: "sqlite" (default, local) or "postgres" (production)
DB_ENGINE=sqlite
POSTGRES_DB=proteccion_inmediata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Channels: leave empty for the in-memory layer (local dev)
REDIS_URL=

# Email (password recovery). Development defaults to the console backend,
# which prints the message instead of sending it.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Proteccion Inmediata SC <no-responder@proteccioninmediata.test>

# Password recovery
FRONTEND_URL=http://localhost:4200
PASSWORD_RESET_TIMEOUT_MINUTES=30
PASSWORD_RESET_RATE=5/hour

# Uploads
MAX_IMAGE_UPLOAD_MB=5
